<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<fx:root type="javafx.scene.layout.GridPane" xmlns:fx="http://javafx.com/fxml" stylesheets="@styles.css">
    <columnConstraints>
        <ColumnConstraints percentWidth="100" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints percentHeight="90" />
        <RowConstraints percentHeight="10" />
    </rowConstraints>
    <GridPane fx:id="mergeSortGridPane" GridPane.rowIndex="0" >
        <columnConstraints>
            <ColumnConstraints percentWidth="100" />
        </columnConstraints>
    </GridPane>
    <GridPane GridPane.rowIndex="1">
        <columnConstraints>
            <ColumnConstraints percentWidth="65" />
            <ColumnConstraints percentWidth="35" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints percentHeight="100" />
        </rowConstraints>
        <HBox GridPane.columnIndex="0" alignment="CENTER" spacing="10">
            <Button fx:id="stopButton" text="Stop" minWidth="100"/>
            <Button fx:id="startButton" text="Start" minWidth="100"/>
            <Button fx:id="prevButton" text="Prev" minWidth="100" visible="false" managed="false" />
            <Button fx:id="nextButton" text="Next" minWidth="100" visible="false" managed="false" />
        </HBox>
        <HBox fx:id="arraySizeBox" GridPane.columnIndex="1" alignment="CENTER">
            <Label fx:id="arraySizeLabel" text="Array Size"/>
            <ChoiceBox fx:id="arraySizeChoiceBox" prefHeight="30" prefWidth="150"/>
        </HBox>
    </GridPane>
</fx:root>