<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="ch.fhnw.algdemo.control.history.HistoryController"
            fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="history-parent"
            stylesheets="@styles.css">
    <VBox>
        <Label fx:id="initialStateLabel" text="Initial State" prefWidth="Infinity"
               styleClass="initial-history-element"/>
        <VBox fx:id="historyBox" />
    </VBox>

</ScrollPane>
